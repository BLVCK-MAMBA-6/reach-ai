# Reach AI
APP_ENV=development
APP_NAME=Reach AI
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# Model provider
# Keep this as mock until Nebius access is approved.
MODEL_PROVIDER=mock

# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=

# Tavily
TAVILY_API_KEY=

# PostgreSQL and pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reach_ai

# Agent memory
MEMORY_PROVIDER=disabled
MEMORI_API_KEY=
MEM0_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Security
SESSION_SECRET=
ENCRYPTION_KEY=

# Observability
LOG_LEVEL=INFO
ENABLE_MODEL_USAGE_LOGGING=true
